# Server porti
PORT=3000

# JWT imzolash uchun maxfiy kalit (uzun tasodifiy satr qo'ying!)
JWT_SECRET=change-me-to-a-long-random-string

# Supabase Auth (Google orqali kirish) — Supabase Dashboard → Project Settings → API
# Bu qiymatlar o'rnatilsa, Google tugmasi Supabase orqali ishlaydi (GOOGLE_CLIENT_ID shart emas)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# (Muqobil) Supabase'siz to'g'ridan-to'g'ri Google OAuth Client ID (Google Cloud Console → APIs & Services → Credentials)
# Authorized JavaScript origins: http://localhost:3000 (va production domeningiz)
GOOGLE_CLIENT_ID=

# Birinchi ishga tushishda yaratiladigan admin hisobi
ADMIN_EMAIL=admin@webpa.uz
ADMIN_PASSWORD=webpa-admin-2026

# Google orqali kirganda avtomatik admin bo'ladigan emaillar (vergul bilan)
ADMIN_EMAILS=

# production'da: NODE_ENV=production (cookie faqat HTTPS orqali yuboriladi)
NODE_ENV=development
